package myapp:plugin@0.1.0;

interface types {
    record http-header {
        name: string,
        value: string,
    }

    record http-request {
        method: string,
        uri: string,
        headers: list<http-header>,
        body: option<list<u8>>,
    }

    record http-response {
        status: u16,
        headers: list<http-header>,
        body: option<list<u8>>,
    }

    record user-snapshot {
        id: u64,
        tenant-id: u64,
        email: string,
        locale: string,
        tier: user-tier,
    }
    enum user-tier { free, pro, enterprise }

    record payment-snapshot {
        id: u64,
        amount-cents: s64,
        currency: string,
        method: string,
        created-at: u64,
    }

    record payment-made-event {
        user: user-snapshot,
        payment: payment-snapshot,
    }
    record reward-granted-event {
        user: user-snapshot,
        reward-cents: s64,
        triggered-by-payment: u64,
    }

    /// Strongly-typed payloads for built-in system events.
    variant system-event {
        payment-made(payment-made-event),
        reward-granted(reward-granted-event),
    }

    /// Discriminant for system events, used in subscription declarations.
    enum system-event-kind { payment-made, reward-granted }

    /// Plugin-introduced custom event — %name identifies the type, payload is opaque bytes.
    record custom-event {
        name: string,
        payload: list<u8>,
    }

    /// All events on the bus: built-in system events or plugin-introduced custom events.
    variant event-payload {
        system(system-event),
        custom(custom-event),
    }

    /// What a plugin subscribes to: a known system event (enum-keyed) or a custom event (string-keyed).
    variant event-subscription {
        system(system-event-kind),
        custom(string),
    }

    record event-envelope {
        id: u64,
        emitted-at: u64,
        chain-depth: u8,
        source: event-source,
        payload: event-payload,
    }
    variant event-source { host, plugin(string) }

    record rendered-query {
        sql: string,
        binds: list<list<u8>>,
        bind-types: list<u32>,
    }

    record migration {
        version: string,
        up-sql: string,
        down-sql: string,
    }

    variant plugin-error {
        db-error(string),
        invalid-input(string),
        not-found,
        internal(string),
    }

    enum log-level { error, warn, info, debug }

    /// Typed WebSocket frame. %close carries an optional close reason.
    variant ws-message {
        text(string),
        binary(list<u8>),
        close(option<string>),
    }

    /// All static plugin metadata returned in a single host call, avoiding repeated instantiations at load time.
    record plugin-manifest {
        name: string,
        version: string,
        subscribed-events: list<event-subscription>,
        migrations: list<migration>,
        openapi: string,
    }
}

interface host-api {
    use types.{rendered-query, plugin-error, event-payload, log-level,
               user-snapshot, user-tier, payment-snapshot};

    /// Asynchrony is declared here, in the contract — not in bindgen options.
    /// A function is `async func` when the host implementation genuinely awaits
    /// (I/O, channels); everything else stays sync so the guest is not forced to
    /// suspend for an in-process call.
    db-query: async func(q: rendered-query)
        -> result<list<list<list<u8>>>, plugin-error>;
    db-execute: async func(q: rendered-query) -> result<u64, plugin-error>;

    /// Non-blocking: pushes onto the dispatcher's broadcast channel.
    emit-event: func(payload: event-payload) -> result<_, plugin-error>;

    cache-get: func(key: string) -> option<list<u8>>;
    cache-set: func(key: string, value: list<u8>, ttl-secs: u32);

    log: func(level: log-level, msg: string);

    /// Look up a single user by primary key.
    get-user: async func(user-id: u64) -> result<user-snapshot, plugin-error>;
    /// List all users belonging to a tenant.
    list-users: async func(tenant-id: u64) -> result<list<user-snapshot>, plugin-error>;
    /// Create a new user; returns the persisted snapshot.
    create-user: async func(tenant-id: u64, email: string, locale: string, tier: user-tier)
        -> result<user-snapshot, plugin-error>;

    /// Look up a single payment by primary key.
    get-payment: async func(payment-id: u64) -> result<payment-snapshot, plugin-error>;
    /// List all payments for a user.
    list-user-payments: async func(user-id: u64) -> result<list<payment-snapshot>, plugin-error>;
    /// Record a new payment; returns the persisted snapshot.
    create-payment: async func(user-id: u64, amount-cents: s64, currency: string, method: string)
        -> result<payment-snapshot, plugin-error>;

    // WebSocket and SSE traffic no longer crosses the boundary one call at a
    // time: both are component-model streams passed to / returned from the
    // handlers in plugin-api below.
}

interface plugin-api {
    use types.{event-envelope, plugin-error, http-request, http-response, plugin-manifest,
               ws-message};

    /// Return all static metadata in one call. HTTP routes are derived by the host from
    /// the openapi field; no separate http-routes list is needed.
    /// Pure metadata assembly — stays sync.
    manifest: func() -> plugin-manifest;

    init: async func() -> result<_, plugin-error>;
    handle-event: async func(evt: event-envelope) -> result<_, plugin-error>;
    handle-http: async func(req: http-request) -> result<http-response, plugin-error>;

    /// Called once per WebSocket connection. `incoming` carries client frames;
    /// the returned stream carries replies.
    ///
    /// `async func`, not plain `func`: the handles are returned promptly via
    /// task.return, but the plugin keeps producing into the reply stream
    /// afterwards. A sync-lifted export has no callback to be re-entered on, so
    /// its spawned producer would never run — the stream would hang open and
    /// deliver nothing. (WASI 0.3 can use plain `func` for the same shape
    /// because there the *host* produces, not a guest.)
    ///
    /// The returned future reports how the connection ended: dropping the reply
    /// stream closes it, and the future then resolves. Stream carries data,
    /// future carries the terminal result.
    handle-websocket: async func(path: string, conn-id: u64, incoming: stream<ws-message>)
        -> tuple<stream<ws-message>, future<result<_, plugin-error>>>;

    /// Called once per SSE connection. Each item on the returned stream becomes
    /// one `data:` line; dropping the stream closes it. `async func` for the
    /// same reason as handle-websocket above.
    handle-sse: async func(path: string, conn-id: u64)
        -> tuple<stream<list<u8>>, future<result<_, plugin-error>>>;
}

/// The contract the host implements and calls. WASI is deliberately absent:
/// the host serves it through `p2::add_to_linker` / `p3::add_to_linker`, not
/// through these bindings.
world plugin {
    import host-api;
    export plugin-api;
}

/// What plugins generate against: everything in `plugin`, plus the WASI 0.3
/// interfaces they may call directly.
///
/// Real WASI 0.3, imported alongside the wasi:*@0.2.x that std pulls in on the
/// wasm32-wasip2 target — the host links both, so a plugin can await `wait-for`
/// with none of the 0.2 pollable dance. This is what makes timers possible
/// inside a plugin at all.
world plugin-guest {
    include plugin;
    import wasi:clocks/monotonic-clock@0.3.0;
}
