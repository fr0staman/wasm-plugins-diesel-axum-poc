# Required: PostgreSQL connection string
DATABASE_URL=postgresql://diesel_poc:dsl-pc-pswd@localhost:5432/diesel_db_poc

# Required: comma-separated list of plugins to load
PLUGINS=bonus,push

# Optional: directory that contains compiled .wasm files (default: plugins)
# WASM_PLUGIN_DIR=plugins

# Optional: port for the Axum server (default: 3000)
# HOST_PORT=3000

# Optional: tracing filter (default: info)
# RUST_LOG=info
